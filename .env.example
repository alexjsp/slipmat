# Copy to .env (local) or create on the server at the deploy path.

# Shared password for the web UI. Leave unset in local dev to disable auth.
DOMOVOI_PASSWORD=
# Any long random string; rotating it logs everyone out.
DOMOVOI_SESSION_SECRET=

DOMOVOI_PORT=5544
DOMOVOI_LOG_LEVEL=info

# Only needed when SSDP discovery is blocked. One speaker's IP is enough —
# Domovoi finds the rest of the household from it.
DOMOVOI_SEED_IP=

# Optional embedded HomeKit bridge. Off unless set to 1.
DOMOVOI_HOMEKIT=0
DOMOVOI_HOMEKIT_PIN=031-45-154
DOMOVOI_HOMEKIT_NAME=Domovoi

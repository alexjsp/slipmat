{
  "name": "@slipmat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@slipmat/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@homebridge/hap-nodejs": "^2.2.0",
    "@svrooij/sonos": "^2.5.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}

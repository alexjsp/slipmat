#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

DEPLOY_HOST="${DEPLOY_HOST:-root@unraid.jsp.scot}"
DEPLOY_PATH="${DEPLOY_PATH:-/mnt/user/appdata/slipmat_source}"
COMPOSE_FILE="${COMPOSE_FILE:-compose.yml}"
DEPLOY_PROJECT_NAME="${DEPLOY_PROJECT_NAME:-slipmat}"
# Must match the bind mount in compose.yml, and the uid/gid in the Dockerfile.
# A bind mount shadows the image's own /data, ownership included, so the host
# directory has to be given to the container's user or SQLite cannot open the
# database and the container crash-loops on SQLITE_CANTOPEN.
DATA_PATH="${DATA_PATH:-/mnt/user/appdata/slipmat}"
DATA_OWNER="${DATA_OWNER:-10001:10001}"
RSYNC_RSH="${RSYNC_RSH:-ssh}"
RSYNC_FLAGS="${RSYNC_FLAGS:--az}"

SYNC_PATHS=(
  "./${COMPOSE_FILE}"
  "./Dockerfile"
  "./package.json"
  "./pnpm-workspace.yaml"
  "./pnpm-lock.yaml"
  "./tsconfig.base.json"
  "./biome.json"
  "./packages/"
)

echo "Deploying Slipmat to ${DEPLOY_HOST}:${DEPLOY_PATH}"
echo "Using Compose project ${DEPLOY_PROJECT_NAME}"

ssh "${DEPLOY_HOST}" "mkdir -p '${DEPLOY_PATH}' '${DATA_PATH}' && chown '${DATA_OWNER}' '${DATA_PATH}'"

(
  cd "${ROOT_DIR}"
  # --delete keeps the remote tree honest; node_modules and dist are rebuilt
  # inside the image, so there is no point shipping them.
  rsync ${RSYNC_FLAGS} --delete --relative -e "${RSYNC_RSH}" \
    --exclude 'node_modules' \
    --exclude 'dist' \
    --exclude 'data' \
    "${SYNC_PATHS[@]}" \
    "${DEPLOY_HOST}:${DEPLOY_PATH}/"
)

REMOTE_CMD="$(cat <<EOF
set -euo pipefail
cd '${DEPLOY_PATH}'
# .env is optional — it only carries settings like SLIPMAT_PASSWORD, and auth
# is off by default.
touch .env
docker compose -p '${DEPLOY_PROJECT_NAME}' -f '${COMPOSE_FILE}' build
docker compose -p '${DEPLOY_PROJECT_NAME}' -f '${COMPOSE_FILE}' up -d
docker compose -p '${DEPLOY_PROJECT_NAME}' -f '${COMPOSE_FILE}' ps
EOF
)"

ssh "${DEPLOY_HOST}" "${REMOTE_CMD}"

echo "Done."
